{
  "name": "laras-bi-local",
  "version": "1.0.0",
  "description": "Local business intelligence with Supabase and ChatGPT OAuth",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run test:worker",
    "test:worker": "workerd test tests/worker/config.capnp",
    "check": "node --check web/app.js && node --check web/uploads.js && node --check server/app.js && node --check local/server.mjs && node --check local/chatgpt.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env --use-env-proxy scripts/start.mjs",
    "supabase:provision": "node --env-file-if-exists=.env --use-env-proxy scripts/provision-supabase.mjs",
    "db:generate": "drizzle-kit generate",
    "start": "node --env-file-if-exists=.env --use-env-proxy scripts/start.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "workerd": "^1.20261026.1"
  },
  "private": true,
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "unpdf": "^1.9.1"
  },
  "engines": {
    "node": ">=24.6.0"
  }
}
