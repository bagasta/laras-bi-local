# Optional. npm start works without a .env file.
PORT=3000
# Stable local workspace identity. To reuse your own existing cloud workspace,
# set this to that workspace's owner_id. Do not expose this server remotely.
LARAS_LOCAL_OWNER_ID=local-owner

# Optional operator-managed Supabase connection; the UI is usually easier.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORGANIZATION_ID=
SUPABASE_PROJECT_NAME=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=ap-southeast-1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional OpenRouter fallback. ChatGPT OAuth is configured through the UI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
